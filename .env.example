# Simple NCLEX Platform Environment Configuration
# Copy this file to .env.local for local development.

# ── Demo Mode Toggle ──
# When true: Shows clearly marked sample statistics, testimonials, and demo badges.
# When false: Production mode — hides unverified statistics and testimonials, renders only verified DB content.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── Authentication & Security ──
# IMPORTANT: Generate a 64+ char random secret for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev_jwt_secret_change_in_production_2026_nclex
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_2026_nclex

# Seed Admin Account Credentials (Used by seed script)
ADMIN_INITIAL_EMAIL=admin@simplenclex.com
ADMIN_INITIAL_PASSWORD=ChangeThisAdminPassword2026!

# ── Database Connection ──
# Leave unset to use local SQLite (nclex.db).
# In production (e.g. Supabase, Neon, AWS RDS), set your Postgres connection string:
# DATABASE_URL=postgresql://user:password@host:5432/nclex_db?sslmode=require

# ── Public Contact Information ──
NEXT_PUBLIC_CONTACT_EMAIL=support@simplenclex.com
NEXT_PUBLIC_CONTACT_PHONE=+92 300 1234567
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_CONTACT_WHATSAPP=923001234567
NEXT_PUBLIC_OFFICE_ADDRESS=KPK, Pakistan

# ── Public Payment & Banking Information ──
NEXT_PUBLIC_BANK_NAME=Meezan Bank Islamic
NEXT_PUBLIC_BANK_ACCOUNT_TITLE=Simple NCLEX Academy
NEXT_PUBLIC_BANK_IBAN=PK42MEZN0001020304050607
NEXT_PUBLIC_EASYPAISA_NAME=Simple NCLEX Academy
NEXT_PUBLIC_EASYPAISA_NUMBER=0300-1234567
NEXT_PUBLIC_JAZZCASH_NAME=Simple NCLEX Academy
NEXT_PUBLIC_JAZZCASH_NUMBER=0300-1234567
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/sample-class-link

# ── Social Media Channels ──
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com
